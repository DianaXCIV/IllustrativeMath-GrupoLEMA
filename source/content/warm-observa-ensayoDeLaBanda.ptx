<?xml version='1.0' encoding='utf-8'?>

<!-- ====================================================================== 
   El calentamiento es un <exploration> (distinto a las otras actividades)
   Para RRRRR usar el estilo del calentamiento. Por ejemplo, usar 
   RRRRRR=observa con los "Observa y Pregúntate"
===========================================================================  -->
<exploration xml:id="warm-observa-ensayoDeLaBanda" xmlns:xi="http://www.w3.org/2001/XInclude"> 

<title>Observa y pregúntate: Ensayo de la banda</title>

<statement>
  <p>¿Qué observas? ¿Qué te preguntas?</p>
  <sidebyside margins="10% 10%">
    <p><line>Han cenó antes de tomar el bus.</line>
      <line>Cuando bajó del bus, tuvo que apurarse para llegar a tiempo al ensayo de la banda.</line>      
    </p>
  </sidebyside>
  <sidebyside margins="70% 0%">
    <image source="png-source/CS 3.6 Lesson 11.png" component="web">
      <shortdescription>bus</shortdescription>
    </image>
  </sidebyside>
</statement>

<solution>
    <p>[+++++++++++++++]</p>
    <p>Students may notice:</p>
    <ul>
      <li>Han was on the bus for some amount of time.</li>
      <li>Han had band practice after dinner.</li>
      <li>Han was almost late to band practice.</li>
    </ul>
    <p>Students may wonder:</p>
    <ul>
      <li>How long was Han on the bus?</li>
      <li>What time did Han eat dinner?</li>
      <li>What time does band practice start?</li>
    </ul>
  </solution>


<!-- ============================================================== 
   Notas profesor <prelude> (se pueden mostrar previo al enunciado)                      
===================================================================  -->
<prelude component="profesor"> 

  <!-- Estándares CCSS asociados -->
  <paragraphs>
    <title><custom ref="ccss-actividad-titulo"/></title> 
    <ul>
      <li> 
        <custom ref="ccss-addressing"/>
        <xref ref="ccss-3-MD-A-1" text="custom">3.MD.A.1</xref>
      </li>
    </ul>
  </paragraphs>

  <!-- Tiempo recomendado -->
  <paragraphs>
    <title><custom ref="recommended-time-titulo"/></title>
    <p>10 minutos</p>
  </paragraphs>

  <!-- Introducción de la actividad -->  
  <paragraphs>
    <title><custom ref="narrative-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <p>The purpose of this warm-up is to elicit the idea that many different questions could be asked about this situation involving time, which will be useful when students solve problems in a later activity.</p>
  </paragraphs>

  <!-- Launch -->
  <paragraphs>
    <title><custom ref="launch-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>Groups of 2</li>
      <li>Display the situation.</li>
      <li>
        <q>¿Qué observan? ¿Qué se preguntan?</q>
      </li>
      <li>1 minute: quiet think time</li>
    </ul>
  </paragraphs>

  <!-- Instrucciones para el desarrollo de la actividad -->
  <paragraphs>
    <title><custom ref="instructions-teacher-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>
        <q>Discutan con su compañero lo que pensaron</q>
      </li>
      <li>1 minute: partner discussion</li>
      <li>Share and record responses.</li>
    </ul>
  </paragraphs>

</prelude>


<!-- ============================================================== 
   Notas profesor <postlude> (se pueden mostrar después del enunciado)                      
===================================================================  -->
<postlude component="profesor">

  <!-- Síntesis de la actividad -->
  <paragraphs>
    <title><custom ref="synthesis-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>
        <q>Agreguémosle tiempos a la situación de Han. ¿Qué tiempos podríamos agregar?</q> (The time he started or finished dinner. The amount of time he was on the bus. How long he waited for the bus. The time his band practice started.)
      </li>
      <li>
        <q>¿Qué tipo de preguntas podríamos hacer sobre esta situación?</q>
      </li>
    </ul>
  </paragraphs>

</postlude>

</exploration>