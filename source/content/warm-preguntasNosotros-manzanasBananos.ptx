<!-- ====================================================================== 
   El calentamiento es un <exploration> (distinto a las otras actividades)
   Para RRRRR usar el estilo del calentamiento. Por ejemplo, usar 
   RRRRRR=observa con los "Observa y Pregúntate"
===========================================================================  -->
<exploration xml:id="warm-preguntasNosotros-manzanasBananos" xmlns:xi="http://www.w3.org/2001/XInclude"> 

<title>Preguntas sobre nosotros: ¿Manzanas o bananos?</title>

<statement>
  <p>¿Nos gustan más las manzanas o los bananos?</p>
</statement>

<solution>
    <p>Sample responses:</p>
    <ul>
      <li>More students chose apples. I can just see that there are more dots for the apples.</li>
      <li>More students chose apples. 12 students chose apples and 8 students chose bananas. Twelve is more than 8.</li>
    </ul>
  </solution>


<!-- ============================================================== 
   Notas profesor <prelude> (se pueden mostrar previo al enunciado)                      
===================================================================  -->
<prelude component="profesor">
<p>
<dl>
 
  <!-- Estándares CCSS asociados -->
  <li>
    <title><custom ref="ccss-actividad-titulo"/></title> 
    <ul>
      <li>
        <custom ref="ccss-addressing"/>
        <xref ref="ccss-K-CC-B" text="custom">K.CC.B</xref>
      </li>
    </ul>
  </li>
<!-- Tiempo recomendado -->
  <li>
    <title><custom ref="recommended-time-titulo"/></title>
    <p>10 minutos</p>
  </li>

  <!-- Introducción de la actividad -->  
  <li>
    <title><custom ref="narrative-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <p>The purpose of this warm-up is for students to consider concepts of number in a familiar context.  Students compare groups of images in the synthesis. Save the completed chart to use in future lessons.</p>
  </li>

  <!-- Materiales requeridos de la actividad -->
  <li>
    <title><custom ref="materials-actividad-titulo"/></title>
    <xi:include href="./warm-preguntasNosotros-manzanasBananos-mat.ptx"/> 
  </li>

  <!-- Launch -->
  <li>
    <title><custom ref="launch-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>Groups of 2</li>
      <li>Display the Questions About Us Chart.</li>
      <li>
        <q>¿Qué fruta les gusta más: manzana o banano?</q>
      </li>
      <li>30 seconds: quiet think time</li>
      <li>Record each student's choice with a circle in a 5-frame.</li>
    </ul>
  </li>

  <!-- Instrucciones para el desarrollo de la actividad -->
  <li>
    <title><custom ref="instructions-teacher-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>
        <q>¿Cómo podemos descifrar cuántos estudiantes prefieren manzana?</q>
      </li>
      <li>30 seconds: quiet think time</li>
      <li>30 seconds: partner discussion</li>
      <li>Share responses.</li>
      <li>Demonstrate or invite students to demonstrate counting.</li>
      <li>
        <q>¿Cuántos estudiantes prefieren manzana?</q>
      </li>
      <li>
        <q>¿Cómo podemos descifrar cuántos estudiantes prefieren banano?</q>
      </li>
      <li>30 seconds: quiet think time</li>
      <li>30 seconds: partner discussion</li>
      <li>Share responses.</li>
      <li>Demonstrate or invite students to demonstrate counting.</li>
      <li>
        <q>¿Cuántos estudiantes prefieren banano?</q>
      </li>
    </ul>
  </li>
</dl>
</p>
</prelude>


<!-- ============================================================== 
   Notas profesor <postlude> (se pueden mostrar después del enunciado)                      
===================================================================  -->
<postlude component="profesor">
<p>
<dl>
