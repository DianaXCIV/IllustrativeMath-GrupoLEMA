<?xml version='1.0' encoding='utf-8'?>

<activity xml:id="act-centros-escoger18" xmlns:xi="http://www.w3.org/2001/XInclude"> 

<title>Centros: Momento de escoger</title>

<statement>
  <p>Escoge un centro.</p>
  <p>Carrera con números</p>
  <image source="png-source/Number Race.png" margins="0% 65%">
    <shortdescription>Centro carrera con números.</shortdescription>
  </image>
  <p>Bloques sólidos geométricos</p>
  <image source="png-source/K.1.A Beta Student Workbook.Geoblocks.png" margins="0% 65%">
    <shortdescription>Centro carrera con números.</shortdescription>
  </image>
  <p>Dedos matemáticos</p>
  <image source="png-source/hand 8b.png" margins="0% 65%">
    <shortdescription>Dos manos contando con dedos.</shortdescription>
  </image>     
</statement>

<!--<solution>
  <p>[@@@@@@@@@]</p>
</solution>-->


<!-- ============================================================== 
   Notas profesor <prelude> (se pueden mostrar previo al enunciado)                      
===================================================================  -->
<prelude component="profesor">
<p>
<dl>
 
  <!-- Tiempo recomendado -->
  <li>
    <title><custom ref="recommended-time-titulo"/></title>
    <p>20 minutos</p>
  </li>

  <!-- Introducción de la actividad -->
  <li>
    <title><custom ref="narrative-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <p>The purpose of this activity is for students to choose from activities that offer practice composing, decomposing, and comparing numbers.</p>
<p>Students choose from any stage of previously introduced centers.</p>
<ul>
      <li>Number Race</li>
      <li>Geoblocks</li>
      <li>Math Fingers</li>
    </ul>
  </li>


  <!-- Materiales requeridos de la actividad -->
  <li>
    <title><custom ref="materials-actividad-titulo"/></title>
    <xi:include href="./act-centros-escoger18-matCentros.ptx"/> 
  </li>

  <!-- Launch -->
  <li>
    <title><custom ref="launch-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>
        <q>Hoy vamos a escoger centros de los que ya conocemos</q>
      </li>
      <li>Display the center choices in the student book.</li>
      <li>
        <q>Piensen qué les gustaría hacer primero</q>
      </li>
      <li>30 seconds: quiet think time</li>
    </ul>
  </li>


  <!-- Instrucciones para el desarrollo de la actividad -->
  <li>
    <title><custom ref="instructions-teacher-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>Invite students to work at the center of their choice.</li>
      <li>8 minutes: center work time</li>
      <li>
        <q>Escojan qué les gustaría hacer ahora</q>
      </li>
      <li>8 minutes: center work time</li>
    </ul>
  </li>
</dl>
</p>
</prelude>


<!-- ============================================================== 
   Notas profesor <postlude> (se pueden mostrar después del enunciado)                      
===================================================================  -->
<postlude component="profesor">
<p>
<dl>
