<!-- ============================================ 
  El cool-down es un <project> 
  (distinto a las otras actividades y a los Practice Problems)
=================================================  -->
<project xml:id="cool-regalitosInvitados" xmlns:xi="http://www.w3.org/2001/XInclude"> 

<title>Regalitos para invitados</title>

<statement>
    <p>Clare tiene 48 marcadores. Ella pone 8 marcadores en cada bolsa de regalitos para su fiesta de cumpleaños. ¿Cuántas bolsas usará?</p>
    <p>¿Cuál dibujo corresponde a la situación? Explica tu razonamiento.</p>
    <sidebyside width="50%">
      <stack>
        <p>A.</p>
        <image source="svg-source/tikz-file-246306">
          <shortdescription>10 groups of 2 dots.</shortdescription>
        </image>
      </stack>
      <stack>
        <p>B.</p>
        <image source="svg-source/tikz-file-246307">
          <shortdescription>10 groups of 2 dots.</shortdescription>
        </image>
      </stack>
    </sidebyside>
    
    <xi:include href="../whitespace/2cm.ptx" />
</statement>

<solution>
  <p>Respuesta de ejemplo: El dibujo B corresponde a la situación porque muestra 8 marcadores en cada bolsa. Después de que los 48 marcadores se dividan en grupos de 8, habrá 6 bolsas.</p>
</solution>

<prelude component="profesor">
<p>
<dl>
  <!-- Estándares CCSS asociados -->
  <li>
    <title><custom ref="ccss-actividad-titulo"/></title> 
    <ul>
      <li>
        <custom ref="ccss-addressing"/>
        <xref ref="ccss-3-OA-A-2" text="custom">3.OA.A.2</xref>
      </li>
    </ul>
  </li>
</dl>
</p>
</prelude>



<!-- ============================================================== 
   Notas profesor <postlude> (se pueden mostrar después del enunciado)                      
===================================================================  -->
<postlude component="profesor">
<p>
<dl>
  <!-- Posibles errores -->
  <li>
    <title><custom ref="errores-cool-titulo"/></title>
    <p>Los estudiantes eligen el dibujo A, que muestra 8 bolsas en lugar de 8 marcadores en cada bolsa.</p>
  </li>


  <!-- Estrategia de apoyo si muchos estudiantes respondieron incorrectamente -->
  <li>
    <title><custom ref="apoyo-cool-titulo"/></title>
    <p>Durante el lanzamiento de la actividad del día siguiente, haga que los estudiantes discutan por qué el dibujo B corresponde a la situación.</p>
  </li>
</dl>
</p>
</postlude>
</project>
