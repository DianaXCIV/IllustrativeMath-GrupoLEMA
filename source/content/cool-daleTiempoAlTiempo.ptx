<!-- ============================================================== 
   Notas profesor <postlude> (se pueden mostrar después del enunciado)                      
===================================================================  -->
<postlude component="profesor"> 

  <!-- Posibles errores -->
  <paragraphs>
    <title><custom ref="errores-cool-titulo"/></title>
    <p>[++++++++++++++++]</p>
    <p>Students do not find a solution to problems in which the time crosses the hour.</p>
  </paragraphs>


  <!-- Estrategia de apoyo si muchos estudiantes respondieron incorrectamente -->
  <paragraphs>
    <title><custom ref="apoyo-cool-titulo"/></title>
    <p>[++++++++++++++++]</p>
    <p>Before the next day’s warm-up, pass back the cool-down and have students discuss ways to keep track of the time when it crosses the hour.</p>
  </paragraphs>

</postlude>

</project>