<?xml version='1.0' encoding='utf-8'?>

<activity xml:id="act-cualBolsa" xmlns:xi="http://www.w3.org/2001/XInclude"> 

<title>¿Cuál bolsa?</title>

<statement>
  <p>Busquen la bolsa que tiene el número de objetos.</p>
</statement>

<solution>
    <p>[+++++++++++++++]</p>
    <p>Students find the bag that contains the given number of objects.</p>
  </solution>


<!-- ============================================================== 
   Notas profesor <prelude> (se pueden mostrar previo al enunciado)                      
===================================================================  -->
<prelude component="profesor">
<p>
<dl>
 
  <!-- Estándares CCSS asociados -->
  <li>
    <title><custom ref="ccss-actividad-titulo"/></title> 
    <ul>
      <li>
        <custom ref="ccss-addressing"/>
        <xref ref="ccss-K-CC-B-4" text="custom">K.CC.B.4</xref>,
        <xref ref="ccss-K-CC-B-5" text="custom">K.CC.B.5</xref>
      </li>
      <li>
        <custom ref="ccss-buildingTowards"/>
        <xref ref="ccss-K-CC-A-3" text="custom">K.CC.A.3</xref>
      </li>
    </ul>
  </li>
<!-- Tiempo recomendado -->
  <li>
    <title><custom ref="recommended-time-titulo"/></title>
    <p>10 minutos</p>
  </li>

  <!-- Introducción de la actividad -->
  <li>
    <title><custom ref="narrative-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <p>The purpose of this activity is for students to match numbers and groups of objects. Students find the bag that contains the given number of objects. The bags can be filled with math tools such as connecting cubes and counters or classroom objects. The number is displayed and said orally to assist students in connecting the written number to the spoken number word.</p>
  </li>


  <!-- Materiales requeridos de la actividad -->
  <li>
    <title><custom ref="materials-actividad-titulo"/></title>
    <!-- si hay materiales, crear el siguiente archivo -mat.ptx y ponerlos ahí (y agregar también el archivo en la lista de materiales de la lección)-->
    <xi:include href="./act-cualBolsa-mat.ptx"/> 
  </li>

  <!-- Launch -->
  <li>
    <title><custom ref="launch-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>Groups of 4</li>
      <li>Give each group of students 4 bags.</li>
      <li>Write or display the number 8.</li>
      <li>
        <q>Encuentren la bolsa que tiene 8 objetos</q>
      </li>
    </ul>
  </li>


  <!-- Instrucciones para el desarrollo de la actividad -->
  <li>
    <title><custom ref="instructions-teacher-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>2 minutes: small-group work time</li>
      <li>Repeat the steps with the numbers 5, 7, and 9.</li>
    </ul>
  </li>
</dl>
</p>
</prelude>


<!-- ============================================================== 
   Notas profesor <postlude> (se pueden mostrar después del enunciado)                      
===================================================================  -->
<postlude component="profesor">
<p>
<dl>
  <!-- Estrategias de apoyo para estudiantes con dificultades 
  <li>
    <title><custom ref="support-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <p>=== NOT PRESENT ===</p>
  </li>-->
  <!-- Síntesis de la actividad -->
  <li>
    <title><custom ref="synthesis-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>Invite a group of students to share which bag contained 9 objects.</li>
      <li>
        <q>¿Cómo saben que esta bolsa de objetos va con el número 9?</q> (We counted them and there are 9.)
      </li>
    </ul>
  </li>


  <!-- Descripción del desarrollo de lenguaje matemático -->
  <li>
    <title><custom ref="language-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <p>MLR8 Discussion Supports. Students should take turns finding a match and explaining their reasoning to their group. Connect to previously learned comparison language by listening for and encouraging the appropriate use of the phrase “mismo número que”.</p>
    <p>Advances: Listening, Speaking</p>
  </li>


  <!-- Estrategias de acceso para estudiantes con discapacidades 
  <li>
    <title><custom ref="accesibility-actividad-titulo"/></title>
    <p>[@@@@@@@@@]</p>
  </li>-->
</dl>
</p>
</postlude>

</activity>