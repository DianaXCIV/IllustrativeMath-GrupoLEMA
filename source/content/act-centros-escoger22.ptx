<?xml version='1.0' encoding='utf-8'?>

<activity xml:id="act-centros-escoger22" xmlns:xi="http://www.w3.org/2001/XInclude"> 

<title>Centros: Momento de escoger</title>

<statement>
  <p>Escoge un centro.</p>
  <sbsgroup margins="0% 70%">
    <sidebyside>
      <p>Historias matemáticas</p>
    </sidebyside>
    <sidebyside>
      <image source="png-source/MathStories (1).png">
        <shortdescription>Centro Historias matemáticas.</shortdescription>
      </image>  
    </sidebyside>
    <sidebyside>
      <p>Mi mate-libreta</p>
    </sidebyside>
    <sidebyside>
      <image source="png-source/city-full-update shortened.png">
        <shortdescription>Centro mi Mate-libreta.</shortdescription>
      </image>
    </sidebyside>
    <sidebyside>
      <p>Carrera con números</p>
    </sidebyside>
    <sidebyside>
      <image source="png-source/Number Race.png">
        <shortdescription>Centro carrera con números.</shortdescription>
      </image>  
    </sidebyside>
  </sbsgroup>
</statement>

