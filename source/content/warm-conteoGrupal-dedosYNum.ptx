<?xml version='1.0' encoding='utf-8'?>

<!-- ====================================================================== 
   El calentamiento es un <exploration> (distinto a las otras actividades)
   Para RRRRR usar el estilo del calentamiento. Por ejemplo, usar 
   RRRRRR=observa con los "Observa y Pregúntate"
===========================================================================  -->
<exploration xml:id="warm-conteoGrupal-dedosYNum" xmlns:xi="http://www.w3.org/2001/XInclude"> 

<title>Conteo grupal: Dedos y números</title>

<statement>
  <p>Contemos con nuestros dedos.</p>
</statement>

<solution>
    <p>[+++++++++++++++]</p>
    <p>Students count to 10 and put up 1 finger for each number.</p>
  </solution>


<!-- ============================================================== 
   Notas profesor <prelude> (se pueden mostrar previo al enunciado)                      
===================================================================  -->
<prelude component="profesor">
<p>
<dl>
 
  <!-- Estándares CCSS asociados -->
  <li>
    <title><custom ref="ccss-actividad-titulo"/></title> 
    <ul>
      <li>
        <custom ref="ccss-addressing"/>
        <xref ref="ccss-K-CC" text="custom">K.CC</xref>,
        <xref ref="ccss-K-CC-A-1" text="custom">K.CC.A.1</xref>
      </li>
    </ul>
  </li>
<!-- Tiempo recomendado -->
  <li>
    <title><custom ref="recommended-time-titulo"/></title>
    <p>10 minutos</p>
  </li>

  <!-- Introducción de la actividad -->  
  <li>
    <title><custom ref="narrative-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <p>The purpose of this warm-up is for students to practice the verbal count sequence to 10 and show quantities with their fingers.</p>
  </li>

  <!-- Materiales requeridos de la actividad -->
  <!-- <li> -->
    <!-- <title><custom ref="materials-actividad-titulo"/></title> -->
    <!-- <p>[@@@@@@@@@@@@@@]</p> -->
    <!-- <xi:include href="./warm-RRRRRR-SSSSSS-mat.ptx"/>  -->
  <!-- </li> -->

  <!-- Launch -->
  <li>
    <title><custom ref="launch-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>Groups of 2</li>
      <li>
        <q>Mientras cuento hasta 10, levanten un dedo cuando digo cada número</q>
      </li>
      <li>Count to 10 as students put up their fingers.</li>
    </ul>
  </li>

  <!-- Instrucciones para el desarrollo de la actividad -->
  <li>
    <title><custom ref="instructions-teacher-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>
        <q>Ahora contemos hasta 10 con nuestros dedos. Cada vez que digan un número, levanten un dedo</q>
      </li>
      <li>Count to 10 as a class using fingers 2–3 times.</li>
      <li>
        <q>Mientras cuentan y levantan sus dedos, yo escribo los números</q>
      </li>
      <li>Write numbers 1–10 as students count and put up their fingers.</li>
    </ul>
  </li>
</dl>
</p>
</prelude>


<!-- ============================================================== 
   Notas profesor <postlude> (se pueden mostrar después del enunciado)                      
===================================================================  -->
<postlude component="profesor">
<p>
<dl>
  <!-- Estrategias de apoyo para estudiantes con dificultades 
  <li>
    <title><custom ref="support-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <p>=== NOT PRESENT ===</p>
  </li>-->
  <!-- Síntesis de la actividad -->
  <li>
    <title><custom ref="synthesis-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>
        <q>Cuenten hasta 10 con su pareja. Un compañero dice los números del 1 al 10 mientras el otro levanta sus dedos</q>
      </li>
      <li>Switch roles.</li>
    </ul>
  </li>


  <!-- Descripción del desarrollo de lenguaje matemático 
  <li>
    <title><custom ref="language-actividad-titulo"/></title>
    <p>[@@@@@@@@@]</p>
  </li>-->

  <!-- Estrategias de acceso para estudiantes con discapacidades 
  <li>
    <title><custom ref="accesibility-actividad-titulo"/></title>
    <p>[@@@@@@@@@]</p>
  </li>-->
</dl>
</p>
</postlude>

</exploration>