<!-- ====================================================================== 
   El calentamiento es un <exploration> (distinto a las otras actividades)
   Para RRRRR usar el estilo del calentamiento. Por ejemplo, usar 
   RRRRRR=observa con los "Observa y Pregúntate"
===========================================================================  -->
<exploration xml:id="warm-conteoGrupal-deADosYDeACinco" xmlns:xi="http://www.w3.org/2001/XInclude"> 

<title>Conteo grupal: De a dos y de a cinco</title>

<statement>
  <p>
    Cuenten de 5 en 5, empezando en 0. ¿Qué patrones ven?
  </p>
</statement>

<solution>
    <p>[+++++++++++++++]</p>
    <tabular top="medium">
     <row left="minor" bottom="minor">
     <cell right="minor">0</cell>
     <cell right="minor">0</cell>
   </row>
   <row left="minor" bottom="minor">
     <cell right="minor">5</cell>
     <cell right="minor">2</cell>
   </row>
   <row left="minor" bottom="minor">
     <cell right="minor">10</cell>
     <cell right="minor">4</cell>
   </row>
   <row left="minor" bottom="minor">
     <cell right="minor">15</cell>
     <cell right="minor">6</cell>
   </row>
   <row left="minor" bottom="minor">
     <cell right="minor">20</cell>
     <cell right="minor">8</cell>
   </row>
   <row left="minor" bottom="minor">
     <cell right="minor">25</cell>
     <cell right="minor">10</cell>
   </row>
   <row left="minor" bottom="minor">
     <cell right="minor">30</cell>
     <cell right="minor">12</cell>
   </row>
   <row left="minor" bottom="minor">
     <cell right="minor">35</cell>
     <cell right="minor">14</cell>
   </row>
   <row left="minor" bottom="minor">
     <cell right="minor">40</cell>
     <cell right="minor">16</cell>
   </row>
   <row left="minor" bottom="minor">
     <cell right="minor">25</cell>
     <cell right="minor">18</cell>
   </row>
   <row left="minor" bottom="minor">
     <cell right="minor">50</cell>
     <cell right="minor">20</cell>
   </row>
   </tabular>
<p>Sample response:</p>
<p>In the fives column:</p>
<ul>
      <li>The ones place alternates 0 and 5.</li>
      <li>The tens place changes after every two counts.</li>
    </ul>
<p>In the twos column:</p>
<ul>
      <li>The ones place counts 0, 2, 4, 6, 8, then repeats.</li>
      <li>The tens column changes after 5 counts.</li>
    </ul>
  </solution>


<!-- ============================================================== 
   Notas profesor <prelude> (se pueden mostrar previo al enunciado)                      
===================================================================  -->
<prelude component="profesor">
<p>
<dl>
 
  <!-- Estándares CCSS asociados -->
  <li>
    <title><custom ref="ccss-actividad-titulo"/></title> 
    <ul>
      <li> 
        <custom ref="ccss-addressing"/>
        <xref ref="ccss-3-OA-A-1" text="custom">3.OA.A.1</xref>
        <!-- <xref ref="ccss-2-OA-C-4" text="custom">2.OA.C.4</xref> -->
      </li>
    </ul>
  </li>

  <!-- Tiempo recomendado -->
  <li>
    <title><custom ref="recommended-time-titulo"/></title>
    <p>10 minutos</p>
  </li>

  <!-- Introducción de la actividad -->  
  <li>
    <title><custom ref="narrative-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <p>The purpose of this Choral Count is for students to practice counting by 5 and 2 and notice patterns in the count. These understandings help students begin to develop fluency and will be helpful later in this lesson when students write multiplication expressions.</p>
<p>When students notice patterns in the count, such as in the count by 5 that the ones place alternates between 0 and 5, they look for and express regularity in repeated reasoning (MP8).</p>
  </li>

  <!-- Materiales requeridos de la actividad -->
  <li>
    <title><custom ref="materials-actividad-titulo"/></title>
    <p>[@@@@@@@@@@@@@@]</p>
    <!-- <xi:include href="./warm-conteoGrupal-deADosYDeACinco-mat.ptx"/>  -->
  </li>

  <!-- Launch -->
  <li>
    <title><custom ref="launch-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>
        <q>Cuenten de 5 en 5, empezando en 0</q>
      </li>
      <li>Record as students count. See Student Responses for recording structure.</li>
      <li>Stop counting and recording at 50.</li>
    </ul>
  </li>

  <!-- Instrucciones para el desarrollo de la actividad -->
  <li>
    <title><custom ref="instructions-teacher-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>
        <q>¿Qué patrones ven?</q>
      </li>
      <li>1-2 minutes: quiet think time</li>
      <li>Record responses.</li>
      <li>Repeat activity. Count by 2, start at 0 and stop at 20.</li>
    </ul>
  </li>
</dl>
</p>
</prelude>


<!-- ============================================================== 
   Notas profesor <postlude> (se pueden mostrar después del enunciado)                      
===================================================================  -->
<postlude component="profesor">
<p>
<dl>
  <!-- Síntesis de la actividad -->
  <li>
    <title><custom ref="synthesis-actividad-titulo"/></title>
    <p>[+++++++++++++++]</p>
    <ul>
      <li>
        <q>¿Cómo les ayudaron algunos patrones a contar a saltos (de 2 en 2 y de 5 en 5)?</q>  (I know that the next count by 5 should end in 5. I know that the next count by 2 should have a 2 in the ones place.)
      </li>
      <li><p>Consider asking:</p><ul>
<li>
<q>¿Quién puede describir el patrón con otras palabras?</q></li>
<li>
<q>¿Alguien quiere compartir otra observación sobre por qué ese patrón ocurre aquí?</q></li>
<li>
<q>¿Están de acuerdo o en desacuerdo? ¿Por qué?</q></li>
</ul>
      </li>
    </ul>
  </li>
</dl>
</p>
</postlude>

</exploration>