  <li>
    <title><custom ref="synthesis-actividad-titulo"/></title>
    <ul>
	    <li>Invite previously selected students to share their work.</li>
	    <li>Invite a los estudiantes previamente seleccionados a compartir su trabajo.</li>
	    <li>
        <q>¿Cómo podemos describir lo que <fillin/> hizo?</q>
      </li>
    </ul>
  </li>


  <!-- Descripción del desarrollo de lenguaje matemático -->
  <!-- <li>
    <title><custom ref="language-actividad-titulo"/></title>
    <p>[@@@@@@@@@]</p>
  </li> -->


  <!-- Estrategias de acceso para estudiantes con discapacidades -->
